{
  "kind": "git-tag",
  "upstream": "https://github.com/google-gemini/gemini-cli.git",
  "tag_regex": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
  "tag_prefix": "v",
  "version_file": "nix/package-manifest.json",
  "version_jq": ".package.version",
  "pinned_paths": ["vendor", "bun.lock"],
  "pinned_flake_regex": "github:google-gemini/gemini-cli|npmDepsHash|Hashes"
}
